# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=clxxxxxxxxxxxxxxxxxxxxxxx

# Deployed relayer URL (Railway / Fly.io / Render).
# After committing an order on-chain, the frontend POSTs the plaintext order
# details here so the relayer can settle the batch. Leave empty in local dev
# to skip (commitment still goes on-chain regardless).
NEXT_PUBLIC_RELAYER_URL=https://your-relayer.railway.app

# ProxyWalletFactory address — deployed to Polygon mainnet (set after deploying contracts).
# When set, claim payouts route to the user's deterministic ProxyWallet (for Railgun shielding).
# When unset, claim payouts route to the user's connected wallet (legacy behaviour).
NEXT_PUBLIC_PROXY_WALLET_FACTORY=

# PostHog analytics — get key from app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# v12 shielded pool. Keep disabled until the deployed addresses, relayer intake,
# recovery rehearsal, and external review are complete.
NEXT_PUBLIC_PRIVATE_TRADING_ENABLED=false
NEXT_PUBLIC_V12_POOL_ADDRESS=
NEXT_PUBLIC_V12_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_V12_DEPOSIT_WALLET=
# Server-only shared secret used to sign Vercel location assertions for the relayer.
RELAYER_PROXY_SECRET=
