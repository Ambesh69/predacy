# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=clxxxxxxxxxxxxxxxxxxxxxxx

# Deployed relayer URL (Railway / Fly.io / Render).
# After committing an order on-chain, the frontend POSTs the plaintext order
# details here so the relayer can settle the batch. Leave empty in local dev
# to skip (commitment still goes on-chain regardless).
NEXT_PUBLIC_RELAYER_URL=https://your-relayer.railway.app
